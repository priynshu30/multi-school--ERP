# Copy this file to .env on the production server and replace every placeholder.
# Do not commit the production .env file.

NODE_ENV=production
PORT=5000

# Same-domain deployment: Nginx serves the frontend and proxies /api to the server.
CLIENT_URL=https://your-domain.com

# Use MongoDB Atlas or a private MongoDB service for production.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/multi-school-erp?retryWrites=true&w=majority

# Generate two different random values, each at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# The frontend uses the same-domain relative API path: /api/v1.
# No VITE_API_URL is required for this Docker deployment.